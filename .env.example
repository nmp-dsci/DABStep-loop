# Copy to .env. Never commit .env.
#
# Billing is the subscription in dev: leave ANTHROPIC_API_KEY unset (or blank)
# and be logged in to the Claude CLI (`claude login`). The runner refuses to
# start if both a key and BILLING=subscription are present, so a per-token bill
# cannot happen by accident.
BILLING=subscription
# ANTHROPIC_API_KEY=

# Central MLflow (nmp-central-ai; `make platform-up`). The old sqlite store under .mlflow/ is an archive.
MLFLOW_TRACKING_URI=http://localhost:5000

# Optional: HF token only if the dataset download is rate-limited.
# HF_TOKEN=
MLFLOW_DISABLE_AGENT_HINT=1
